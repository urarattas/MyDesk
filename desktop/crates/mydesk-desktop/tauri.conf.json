{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyDesk",
  "version": "0.1.0",
  "identifier": "dev.mydesk.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "MyDesk 远程桌面（原生键鼠注入）",
    "longDescription": "MyDesk 桌面客户端：Tauri WebView 承载网页版 UI，Rust 侧负责原生键鼠注入与截屏。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
